const SYSTEM_SOURCES = {};
SYSTEM_SOURCES.notes = String.raw`app "Notes"
meta id "notes"
meta icon "📝"
meta color "#f0a33b"
meta version "1.0 Beta"

on start
  ui.header("Notes", "Saved locally with MScript data functions")
  ui.section("Editor")
  ui.input("name", "File name", data.get("lastName", "New Note"))
  ui.textarea("body", "Contents", data.globalGet("notes.file." + data.get("lastName", "New Note"), ""), "Write anything...")
  ui.button("save", "Save file", "primary")
  ui.button("new", "New", "secondary")
  ui.button("delete", "Delete", "danger")
  ui.section("Saved files")
  ui.noteList("notes.file.")
end

on click save
  let name = ui.value("name")
  let body = ui.value("body")
  if name == ""
    system.toast("Enter a file name")
  else
    data.globalSet("notes.file." + name, body)
    data.set("lastName", name)
    notify.send("Notes", "Saved " + name)
    app.open("notes")
  end
end

on click new
  data.set("lastName", "Untitled")
  app.open("notes")
end

on click delete
  let name = ui.value("name")
  data.globalDelete("notes.file." + name)
  data.set("lastName", "New Note")
  system.toast("Deleted " + name)
