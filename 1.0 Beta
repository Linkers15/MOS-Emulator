    'permission.disableSuperuser':'Relinquishes Superuser only when called by the current Superuser holder itself. It takes no parameters and returns true on success.',
    'permission.ask':'Shows a MellorsOS permission sheet when needed and returns true when permission is available, false when declined/unavailable.',
    'permission.set':'Changes an ordinary permission. Requires Modify permissions; it can never grant, revoke, or transfer Superuser.',
    'app.install':'Validates complete MScript source, then installs it when authorized. Returns true on success or false when validation/installation fails.',
    'app.remove':'Uninstalls a user app; the current Superuser holder can also remove built-in system apps.',
    'dialog.alert':'Shows a native MellorsOS alert and resumes MScript after dismissal.',
    'dialog.confirm':'Shows a native confirmation and returns true for Confirm or false for Cancel.',
    'dialog.danger':'Shows a danger-styled confirmation and returns true or false.',
    'dialog.choose':'Shows a native two-choice dialog with custom button labels and returns true or false.',
    'events.emit':'Queues a custom event in the current app.',
    'toast':'Top-level shorthand for system.toast().' 
  };
  if(summaries[path])return summaries[path];
  const [ns,name]=path.includes('.')?path.split('.'):[null,path];
  const verbs={get:'Reads',set:'Writes',has:'Checks',clear:'Clears',count:'Counts',list:'Lists',open:'Opens',close:'Closes',remove:'Removes',exists:'Checks whether',isRunning:'Checks whether',stop:'Stops',start:'Starts',reset:'Resets',toggle:'Toggles',name:'Returns a display name for',version:'Returns the version of',current:'Returns the current app id.',source:'Returns source code for',preview:'Runs a non-installed preview of',send:'Creates',install:'Installs',ask:'Requests',holder:'Returns the current Superuser holder id.',isSuperuser:'Returns whether this app is the actual Superuser holder.',after:'Schedules a one-shot timer.',every:'Schedules a repeating foreground timer.',emit:'Emits',info:'Returns system information selected by key.',time:'Returns the formatted local time.',date:'Returns the formatted local date.',now:'Returns the current epoch time in milliseconds.',uptime:'Returns emulator uptime in seconds.',random:'Returns a random integer between the supplied bounds.',storageBytes:'Returns estimated MellorsOS browser-storage use in bytes.',screenWidth:'Returns the emulator viewport width.',screenHeight:'Returns the emulator viewport height.',vibrate:'Requests device vibration when the browser supports it.',clipboard:'Copies text to the clipboard when browser permission allows it.'};
  if(verbs[name])return verbs[name]+(verbs[name].endsWith('.')?'':` ${ns||'the requested value'}.`);
  return `MScript ${path} API function.`;
}
function apiReferenceHTML(rt){
  const groups=[];
  for(const [ns,obj] of Object.entries(rt.api)){
    if(typeof obj==='function'){groups.push({name:'Top-level',items:[[ns,obj]]});continue;}
    if(!obj||typeof obj!=='object')continue;
    const items=Object.entries(obj).filter(([,fn])=>typeof fn==='function').map(([name,fn])=>[`${ns}.${name}`,fn]);
    if(items.length)groups.push({name:ns,items});
  }
  groups.sort((a,b)=>a.name.localeCompare(b.name));
  return groups.map(group=>{
    const cards=group.items.sort((a,b)=>a[0].localeCompare(b[0])).map(([path,fn])=>{
      const src=Function.prototype.toString.call(fn);const m=src.match(/^[^(]*\(([^)]*)\)/);const params=(m?m[1]:'').split(',').map(x=>x.trim()).filter(Boolean);
      const paramRows=params.length?params.map(raw=>{const name=raw.split('=')[0].trim(),def=raw.includes('=')?raw.slice(raw.indexOf('=')+1).trim():'';return `<div class="row" style="align-items:flex-start"><div class="row-main"><div class="row-title">${escapeHTML(name)} <span class="small">· ${escapeHTML(apiParamType(path,name))}</span></div><div class="row-sub">${escapeHTML(apiParamDescription(path,name))}${def?` Default: ${escapeHTML(def)}.`:''}</div></div></div>`;}).join(''):'<div class="row-sub">No parameters.</div>';
      return `<div class="card"><pre class="code" style="margin-top:0">${escapeHTML(path+'('+params.join(', ')+')')}</pre><div class="row-sub" style="margin:8px 0 10px">${escapeHTML(apiFunctionSummary(path))}</div>${paramRows}</div>`;
    }).join('');
    return `<div class="section-title">${escapeHTML(group.name)} parameters</div>${cards}`;
  }).join('');
}

