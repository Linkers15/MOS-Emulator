async function handlePermissionPrompt(rt,permission){
  const app=rt.app;permission=String(permission);
  if(permission==='superuser'){
    const holder=superuserHolder();
    if(holder&&holder!==app.meta.id){
      const holderApp=getApp(holder);
      await showOSDialog({icon:'🔒',title:'Superuser unavailable',message:`Only one app can have Superuser. ${holderApp?.meta.name||holder} already has it.`,detail:'The existing Superuser app must disable its own Superuser access, or the device must be factory reset, before another app can request it.',buttons:[{label:'OK',value:false,kind:'primary'}]});
      return false;
    }
    const first=await showOSDialog({icon:'⚠️',title:'Superuser request',message:`${app.meta.name} is asking for absolute control of MellorsOS.`,detail:'Superuser bypasses every protected permission and gives this app access to system settings, notifications, app installation, permission changes, background processes, protected storage, and device reset.',buttons:[{label:'Do not allow',value:false,kind:'secondary'},{label:'Continue',value:true,kind:'danger'}]});
    if(!first)return false;
    const second=await showOSDialog({icon:'🔐',title:'This is difficult to undo',message:'Only one installed app can hold Superuser at a time.',detail:'After granting it, Settings cannot turn Superuser off and no other MScript app can disable or uninstall the Superuser app. The app must disable Superuser itself, or you must factory reset MellorsOS.',buttons:[{label:'Cancel',value:false,kind:'secondary'},{label:'I understand',value:true,kind:'danger'}]});
    if(!second)return false;
    const third=await showOSDialog({icon:'‼️',title:'Final confirmation',message:`Grant Superuser to ${app.meta.name}?`,detail:'Only approve code you completely trust. This app will have unrestricted MellorsOS control.',buttons:[{label:'Cancel',value:false,kind:'secondary'},{label:'Grant Superuser',value:true,kind:'danger'}]});
    if(!third)return false;
    const granted=grantSuperuserFromRequest(app.meta.id);
    if(granted)log(`${app.meta.name} was granted Superuser`);
    return granted;
  }
  const granted=await showOSDialog({icon:'🛡️',title:'Allow this permission?',message:`${app.meta.name} wants: ${permissionLabel(permission)}`,detail:'You can change ordinary app permissions later in Settings → App Manager.',buttons:[{label:'Decline',value:false,kind:'secondary'},{label:'Allow',value:true,kind:'primary'}]});
  if(granted)setAppPermission(app.meta.id,permission,true);else setAppPermission(app.meta.id,permission,false);
  log(`${app.meta.name} permission ${permission}: ${granted?'granted':'declined'}`);
  return !!granted;
}
