const systemApps=[];
for(const src of Object.values(SYSTEM_SOURCES)){try{const a=parseMScript(src);a.system=true;systemApps.push(a);}catch(e){console.error('Built-in parse error',e,src);}}
store.rawSet('starter.source',STARTER);
function getInstalled(){const srcs=store.rawGet('installedApps',[])||[];return srcs.map(src=>{try{const a=parseMScript(src);a.system=false;return a;}catch{return null;}}).filter(Boolean);}
function sanitizeInstalledApps(){
  const srcs=store.rawGet('installedApps',[])||[];const valid=[];const validIds=new Set();let removed=0;
  for(const src of srcs){try{const app=validateMScriptForInstall(String(src));valid.push(String(src));validIds.add(String(app.meta.id));}catch{removed++;}}
  if(removed){
    store.rawSet('installedApps',valid);
    const all=permissionRecords();let permissionsChanged=false;
    for(const id of Object.keys(all)){
      if(all[id]?.superuser===true)continue;
      if(!validIds.has(id)){delete all[id];permissionsChanged=true;}
    }
    if(permissionsChanged)store.rawSet('permissions',all);
    notify('MScript Installer',`Removed ${removed} invalid legacy app${removed===1?'':'s'} that could not pass installation validation.`,'system');
    log(`Removed ${removed} invalid legacy installed app record(s)`);
  }
  return removed;
}
function getDisabledSystemApps(){return (store.rawGet('disabledSystemApps',[])||[]).map(String);}
function setSystemDisabled(id,disabled){id=String(id);let list=getDisabledSystemApps().filter(x=>x!==id);if(disabled)list.push(id);store.rawSet('disabledSystemApps',[...new Set(list)]);return true;}
function getActiveSystemApps(){const disabled=getDisabledSystemApps();return systemApps.filter(a=>!disabled.includes(a.meta.id));}
function getAllApps(){const installed=getInstalled();const installedIds=new Set(installed.map(a=>a.meta.id));return [...getActiveSystemApps().filter(a=>!installedIds.has(a.meta.id)),...installed];}
function getApp(id){id=String(id);return getAllApps().find(a=>a.meta.id===id);}
function getHiddenApps(){return store.rawGet('hiddenApps',[])||[];}
function setAppHidden(id,hidden){id=String(id);let list=getHiddenApps().filter(x=>x!==id);if(hidden)list.push(id);store.rawSet('hiddenApps',list);return true;}
function installFailure(message,line=0){const detail=`${String(message)}${line?` (line ${line})`:''}`;log(`MScript install rejected: ${detail}`);notify('MScript Installer',`Installation failed: ${detail}`,'system');toast('App not installed — see Notifications');return false;}
function installMScript(source,requesterId=''){try{const app=validateMScriptForInstall(source);const requester=String(requesterId);const holder=superuserHolder();const builtIn=systemApps.find(a=>a.meta.id===app.meta.id);if(builtIn&&holder!==requester)return installFailure('That app id belongs to a built-in system app');if(holder===app.meta.id&&requester!==app.meta.id)return installFailure('The Superuser app is protected from replacement');if(builtIn&&holder===requester)setSystemDisabled(app.meta.id,true);let srcs=store.rawGet('installedApps',[])||[];srcs=srcs.filter(s=>{try{return parseMScript(s).meta.id!==app.meta.id;}catch{return false;}});srcs.push(String(source));store.rawSet('installedApps',srcs);const all=permissionRecords();if(!Object.prototype.hasOwnProperty.call(all,app.meta.id)){all[app.meta.id]={};store.rawSet('permissions',all);}notify('App installed',app.meta.name,app.meta.id);showHome();return true;}catch(e){return installFailure(e?.message||'Unknown MScript installation error',e?.line||0);}}
function uninstallApp(id,requesterId=''){id=String(id);const requester=String(requesterId),holder=superuserHolder(),app=getApp(id);if(!app){toast('App not found');return false;}if(holder===id){toast('Superuser app is protected. It must disable Superuser itself first.');return false;}if(app.system){if(holder!==requester){toast('Only the current Superuser app can remove a built-in system app');return false;}setSystemDisabled(id,true);for(const key of store.keys(`app.${id}.`))store.rawDelete(key);setAppHidden(id,false);stopAppBackground(id);closeRecent(id);toast('System app removed by Superuser');return true;}let srcs=store.rawGet('installedApps',[])||[];srcs=srcs.filter(s=>{try{return parseMScript(s).meta.id!==id;}catch{return false;}});store.rawSet('installedApps',srcs);for(const key of store.keys(`app.${id}.`))store.rawDelete(key);const all=permissionRecords();delete all[id];store.rawSet('permissions',all);setAppHidden(id,false);stopAppBackground(id);closeRecent(id);toast('App uninstalled and its data erased');return true;}
function restoreSystemApp(id){id=String(id);if(!systemApps.some(a=>a.meta.id===id))return false;let srcs=store.rawGet('installedApps',[])||[];srcs=srcs.filter(s=>{try{return parseMScript(s).meta.id!==id;}catch{return false;}});store.rawSet('installedApps',srcs);setSystemDisabled(id,false);setAppHidden(id,false);toast('Built-in system app restored');return true;}
function previewMScript(source){try{const app=parseMScript(source);app.meta.id='preview_'+Date.now();openParsedApp(app,true);return true;}catch(e){showRuntimeError({meta:{name:'Preview',id:'preview',icon:'!',color:'#b03b55'},source},e);return false;}}

/* -------------------------- Window manager -------------------------- */
function renderHome(){
  const hidden=getHiddenApps();const apps=getAllApps().filter(a=>!hidden.includes(a.meta.id)).sort((a,b)=>a.meta.name.localeCompare(b.meta.name));
  root.innerHTML=`<section class="screen" id="home"><div class="home-header"><div><div class="home-title">${escapeHTML(settings.homeTitle)}</div><div class="home-sub">${escapeHTML(settings.homeSubtitle)}</div></div><div class="avatar">${escapeHTML((settings.username||'O')[0].toUpperCase())}</div></div><div id="appGrid">${apps.map(a=>`<button class="app-icon-wrap" data-launch="${a.meta.id}"><span class="app-icon" style="background:linear-gradient(145deg,${a.meta.color},color-mix(in srgb,${a.meta.color} 55%,#111))">${escapeHTML(a.meta.icon)}</span><span class="app-label">${escapeHTML(a.meta.name)}</span></button>`).join('')}</div></section>`;
  document.querySelectorAll('[data-launch]').forEach(el=>el.onclick=()=>openApp(el.dataset.launch)); state.current=null;
}
function pauseCurrent(reason='navigate'){const rt=state.appInstances.get(state.current);if(rt){rt.trigger('pause',{type:'pause',reason});for(const h of rt.foregroundTimers.values()){if(h.kind==='interval')clearInterval(h.id);else clearTimeout(h.id);}rt.foregroundTimers.clear();}}
function showHome(){ if(state.current) state.history.push(state.current); pauseCurrent('home'); renderHome(); }
function openParsedApp(app,preview=false){
  const existing=state.appInstances.get(app.meta.id);if(existing)existing.destroy('relaunch');
  const rt=new MRuntime(app);state.appInstances.set(app.meta.id,rt);state.current=app.meta.id;
  if(!preview){state.recents=state.recents.filter(id=>id!==app.meta.id);state.recents.unshift(app.meta.id);state.recents=state.recents.slice(0,12);}
  log(`Opened ${app.meta.name}`);rt.mount();
}
function openApp(id){id=String(id);const app=getApp(id);if(!app){toast('App not found');return;}if(state.current&&state.current!==id){state.history.push(state.current);pauseCurrent('app-open');}openParsedApp(app);}
function closeRecent(id){state.recents=state.recents.filter(x=>x!==id);const rt=state.appInstances.get(id);if(rt){rt.destroy('recent-close');state.appInstances.delete(id);}if(state.current===id)showHome();}
function showRecents(){
  if(state.current)state.history.push(state.current);pauseCurrent('recents');
  const apps=state.recents.map(getApp).filter(Boolean);
  root.innerHTML=`<section class="screen" id="recents"><div class="app-header"><div class="app-header-icon" style="background:#4e5875">▢</div><div><div class="app-header-title">Recent Apps</div><div class="app-header-sub">Tap a card to reopen · close apps with ×</div></div></div>${apps.length?apps.map(a=>`<div class="recent-card" data-open-recent="${a.meta.id}"><div class="recent-top"><span>${escapeHTML(a.meta.icon)} ${escapeHTML(a.meta.name)}</span><button class="close-x" data-close-recent="${a.meta.id}" aria-label="Close">×</button></div><div class="recent-preview">${escapeHTML(a.meta.icon)}</div></div>`).join(''):'<div class="card center"><div style="font-size:2rem">▢</div><div class="row-title">No recent apps</div></div>'}</section>`;
  document.querySelectorAll('[data-open-recent]').forEach(el=>el.onclick=e=>{if(!e.target.closest('[data-close-recent]'))openApp(el.dataset.openRecent)});
  document.querySelectorAll('[data-close-recent]').forEach(el=>el.onclick=e=>{e.stopPropagation();closeRecent(el.dataset.closeRecent);showRecents();});state.current='__recents';
}
$('#navHome').onclick=()=>{vibrate();const rt=state.appInstances.get(state.current);if(rt?.trigger('homeButton',{type:'homeButton'})===true)return;showHome();};
$('#navRecents').onclick=()=>{vibrate();const rt=state.appInstances.get(state.current);if(rt?.trigger('recentsButton',{type:'recentsButton'})===true)return;showRecents();};
$('#navBack').onclick=()=>{vibrate();if($('#notificationShade').classList.contains('shade-open')){$('#notificationShade').classList.remove('shade-open');return;}const rt=state.appInstances.get(state.current);if(rt?.trigger('back',{type:'back'})===true)return;const prev=state.history.pop();if(prev&&prev!=='__recents'&&getApp(prev))openApp(prev);else showHome();};

let fpsEl=null,lastFrame=performance.now(),frames=0;
function fpsLoop(t){frames++;if(t-lastFrame>=1000){if(settings.showFPS){if(!fpsEl){fpsEl=document.createElement('div');fpsEl.style='position:absolute;top:38px;right:8px;z-index:90;background:#000a;padding:4px 7px;border-radius:8px;font:11px monospace';device.appendChild(fpsEl);}fpsEl.textContent=frames+' FPS';}else if(fpsEl){fpsEl.remove();fpsEl=null;}frames=0;lastFrame=t;}requestAnimationFrame(fpsLoop);}requestAnimationFrame(fpsLoop);

window.addEventListener('error',e=>log(`Kernel error: ${e.message}`));
log('MellorsOS kernel booted');
sanitizeInstalledApps();
renderHome();
})();
</script>
