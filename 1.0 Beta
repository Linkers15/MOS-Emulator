SYSTEM_SOURCES.guide = String.raw`app "MScript Guide"
meta id "guide"
meta icon "📘"
meta color "#4d79e6"
meta version "1.0 Beta"

on start
  ui.header("MScript Guide", "Complete MScript 1.0 Beta language and API reference")
  ui.alert("Everything here is MScript", "System apps and user apps use the same language. Built-in apps are trusted; user apps must request protected permissions. Superuser ownership is enforced by the MellorsOS kernel, not by Settings.", "info")

  ui.section("1 · App structure")
  ui.text("Every app begins with app metadata, then optional functions and event handlers. Statements inside events and functions execute from top to bottom.")
  ui.code("app \"My App\"\nmeta id \"my.app\"\nmeta icon \"◆\"\nmeta color \"#6d7cff\"\nmeta version \"1.0 Beta\"\n\nfunction greet(name)\n  return \"Hello \" + name\nend\n\non start\n  ui.header(\"My App\", greet(\"MellorsOS\"))\nend")
  ui.text("app sets the display name. meta id must uniquely identify the app. meta icon, color, and version control Home-screen and app-header metadata. A custom distribution may change built-in MScript sources, but kernel security rules still apply.", "small")

  ui.section("2 · Comments, values, variables, and operators")
  ui.code("# A comment occupies its own line\nlet score = 10\nset score = score + 5\nlet name = \"MellorsOS\"\nlet enabled = true\nlet empty = null\n\n# Operators\n+  -  *  /  %\n==  !=  <  >  <=  >=\n&&  ||  !")
  ui.text("let and set both assign a variable. Strings use single or double quotes and support \\n, \\t, and \\r escapes. Numbers, true, false, and null are literals. + adds numbers or concatenates when either side is text. Parentheses control expression order. Dotted names such as event.value read properties or API namespaces; function arguments are comma-separated.", "small")

  ui.section("3 · Conditions and loops")
  ui.code("if score >= 10\n  system.toast(\"High score\")\nelse\n  system.toast(\"Keep going\")\nend\n\nlet i = 0\nwhile i < 5\n  set i = i + 1\nend\n\nrepeat 3\n  system.log(index)\nend\n\nfor n from 1 to 5\n  if n == 3\n    continue\n  end\n  if n == 5\n    break\n  end\nend")
  ui.text("if evaluates an expression and optionally runs an else block. while repeats while its condition remains true. repeat count runs a block a fixed number of times and exposes zero-based index. for variable from start to end counts inclusively upward or downward. break exits the nearest loop and continue skips to its next iteration. MellorsOS caps loops and statement execution to protect the emulator.", "small")

  ui.section("4 · Functions and return")
  ui.code("function add(a, b)\n  return a + b\nend\n\non start\n  let result = add(2, 3)\nend")
  ui.text("function name(arguments) defines reusable MScript code. Parameters are local inputs. return ends that function and supplies a value to the caller.", "small")

  ui.section("5 · Events")
  ui.code("on start ... end\non resume ... end\non pause ... end\non close ... end\non back ... end\non homeButton ... end\non recentsButton ... end\non click buttonId ... end\non click ... end\non input fieldId ... end\non input ... end\non change controlId ... end\non change ... end\non dataChange ... end\non settingsChange ... end")
  ui.text("start runs when the app mounts. resume follows start when an app opens. pause runs before navigation leaves the app. close runs when its runtime is destroyed. back, homeButton, and recentsButton fire from the navigation bar; returning true from those navigation events consumes the default action. click, input, and change are generated by UI controls. event.id, event.value, event.type, event.key, event.reason, and similar fields describe the event.", "small")
  ui.code("timer.after(\"welcome\", 1000, \"welcomeTimer\")\nbackground.start(\"sync\", 5000, \"syncTick\")\nevents.emit(\"customEvent\", \"hello\")\n\non welcomeTimer\n  system.toast(event.name)\nend\n\non syncTick\n  system.log(\"Background tick\")\nend\n\non customEvent\n  system.toast(event.value)\nend")
  ui.text("Timer, background, and custom event names are arbitrary. App Manager also emits permissionChange, appVisibility, and uninstallManagedApp to the app hosting ui.appManager(). Specialized widgets emit wallpaper, accent, key, and openNote.", "small")

  ui.section("6 · Permission model")
  ui.code("permission.ask(\"settings\")\npermission.ask(\"notifications\")\npermission.ask(\"installApps\")\npermission.ask(\"modifyPermissions\")\npermission.ask(\"background\")\npermission.ask(\"superuser\")")
  ui.text("User apps start without protected permissions. permission.ask displays a MellorsOS-native prompt and returns true or false. Put permission.ask before other side effects in the handler because the handler resumes after the user answers. Calling a protected command without its permission crashes and exits the user app with an MScript crash notification.", "small")
  ui.code("if permission.ask(\"notifications\")\n  notify.send(\"Hello\", \"Allowed\")\nelse\n  system.toast(\"Using fallback UI\")\nend")
  ui.text("settings protects settings.set, settings.toggle, and settings.reset. notifications protects notification modification. installApps protects app.install and app.remove. modifyPermissions protects permission.set and ui.appManager. background protects background.start. Superuser bypasses protected permissions and adds kernel ownership powers.", "small")

  ui.section("7 · Superuser security")
  ui.text("Only one user app can hold Superuser. It can only be granted when that app itself calls permission.ask(\"superuser\") and the user completes multiple warnings. Settings cannot grant, revoke, transfer, or directly uninstall the holder. No other MScript app, including a built-in or custom Settings app, can disable the holder. The holder relinquishes with permission.disableSuperuser(), or factory reset removes it.")
  ui.text("Superuser can uninstall built-in system apps with app.remove(id), install replacements even using a built-in app id with app.install(source), and restore the original built-in with app.restoreSystem(id). Kernel-owned permissions, installed-app records, and disabled-system-app records cannot be overwritten through data.globalSet.", "small")

  ui.section("8 · UI creation API")
  ui.code("ui.clear()\nui.header(title, subtitle)\nui.section(title)\nui.text(text, style)\nui.rich(title, body, icon)\nui.card(title, body)\nui.menu(id, title, subtitle, icon, value)\nui.alert(title, body, kind)\nui.divider()\nui.spacer(px)\nui.badge(text, kind)\nui.stat(label, value)\nui.progress(title, value, max)\nui.label(id, text, style)\nui.infoRow(title, value, subtitle)")
  ui.text("clear rebuilds the app page as a blank content surface. header explicitly creates or updates the sticky app header; custom apps do not receive an automatic header unless their MScript calls ui.header(). section creates a section heading. text and label render escaped text; label has an id for later mutation. rich/card/infoRow create information surfaces. menu creates a tappable Settings-style row and fires click id. alert kinds are info, warning, danger, or success. divider/spacer control layout. badge/stat/progress display compact status information.", "small")

  ui.section("9 · UI input API")
  ui.code("ui.button(id, label, kind)\nui.input(id, label, value, type)\nui.numberInput(id, label, value, min, max, step)\nui.password(id, label, value)\nui.search(id, label, value)\nui.colorInput(id, label, value)\nui.dateInput(id, label, value)\nui.timeInput(id, label, value)\nui.textarea(id, label, value, placeholder)\nui.codeEditor(id, value)\nui.toggle(id, title, on, subtitle)\nui.slider(id, title, value, min, max, step)\nui.select(id, title, value, \"a:Label A|b:Label B\")\nui.segmented(id, title, value, options)\nui.chips(id, title, selected, options)")
  ui.text("The id parameter names a control and connects it to events. You may write it as a quoted string, such as ui.button(\"save\", ...), or as a bare identifier, such as ui.button(save, ...); both connect to on click save. button kinds are primary, secondary, danger, or ghost. input type accepts normal HTML input types while the dedicated helpers cover common types. toggle, slider, select, segmented, and chips fire change id plus the generic change event. input and numberInput fire input id plus generic input. textarea fires input id. Read current control contents with ui.value(id).", "small")

  ui.section("10 · UI mutation API")
  ui.code("ui.value(id)\nui.setValue(id, value)\nui.clearValue(id)\nui.setText(id, text)\nui.setVisible(id, visible)\nui.setEnabled(id, enabled)\nui.remove(id)\nui.exists(id)\nui.focus(id)\nui.scrollTop()")
  ui.text("These functions inspect or modify controls already rendered on the current app page. setText is intended for elements created with ui.label or other id-bearing controls. setVisible hides without deleting. setEnabled disables interaction. remove deletes the element. focus moves keyboard focus. scrollTop returns to the top of the app page.", "small")

  ui.section("11 · Specialized system UI helpers")
  ui.code("ui.code(text)\nui.noteList(prefix)\nui.appList()\nui.storageView()\nui.notificationList()\nui.calculator()\nui.calcSet(value)\nui.wallpaperPicker()\nui.accentPicker()\nui.logView()\nui.appManager()\nui.refreshAppManager()\nui.htmlSafe(text)")
  ui.text("code renders a formatted code block. noteList lists storage records and emits openNote. appList opens installed apps. storageView, notificationList, calculator/calcSet, wallpaperPicker, accentPicker, and logView power built-in tools. appManager requires Modify permissions and renders app permissions, Home visibility, and uninstall controls while keeping Superuser kernel-controlled. refreshAppManager updates it in place. htmlSafe displays text inside a card and always escapes markup.", "small")

  ui.section("12 · Private and shared storage")
  ui.code("data.get(key, fallback)\ndata.set(key, value)\ndata.delete(key)\ndata.keys(prefix)\ndata.has(key)\ndata.clear()\ndata.count(prefix)\ndata.append(key, value, separator)\ndata.increment(key, amount)\ndata.globalGet(key, fallback)\ndata.globalSet(key, value)\ndata.globalDelete(key)\ndata.globalKeys(prefix)\ndata.globalHas(key)")
  ui.text("Private data functions automatically namespace records to the current app. keys returns | separated key names. clear only clears the current app's private data. append concatenates text and increment updates a numeric record. Ordinary user apps' global functions are sandboxed under shared.*. Built-in apps and Superuser can address broader OS storage, except kernel-owned trust records.", "small")

  ui.section("13 · Settings API")
  ui.code("settings.get(key, fallback)\nsettings.has(key)\nsettings.set(key, value)\nsettings.toggle(key)\nsettings.keys()\nsettings.reset()")
  ui.text("get, has, and keys are readable by apps. set, toggle, and reset require Modify system settings for user apps. Changes are immediately persisted and applied. settingsChange fires in the calling runtime when set, toggle, or reset succeeds.", "small")

  ui.section("14 · App API")
  ui.code("app.open(id)\napp.home()\napp.close(id)\napp.install(source)\napp.remove(id)\napp.restoreSystem(id)\napp.source(id)\napp.preview(source)\napp.exists(id)\napp.list()\napp.name(id)\napp.version(id)\napp.current()\napp.isSystem(id)\napp.isHidden(id)\napp.setHidden(id, hidden)\napp.disabledSystems()")
  ui.text("open launches an app, home shows Home, and close removes a recent runtime. install and remove require Install apps for normal user apps. app.install validates the entire source before writing anything to storage: empty source, missing app/meta id declarations, malformed syntax, invalid ids, duplicate handlers/functions/parameters, unknown function calls, and invalid loop control are rejected. A failed install returns false and MellorsOS posts an MScript Installer notification with the error and line number when available. source returns MScript source for an active app. preview runs source without installing. list returns | separated ids. current returns this app id. setHidden needs system/Superuser authority for user apps. restoreSystem and system-app removal/replacement are restricted to the actual current Superuser holder, not merely a trusted Settings app.", "small")

  ui.section("15 · Notification API")
  ui.code("notify.send(title, body)\nnotify.clear()\nnotify.count()\nnotify.latestTitle()\nnotify.latestBody()\nnotify.remove(id)")
  ui.text("send, clear, and remove modify notifications and require Notifications for user apps. count and latestTitle/latestBody are read-only. send returns the new notification id.", "small")

  ui.section("16 · Permission API")
  ui.code("permission.ask(permission)\npermission.has(permission)\npermission.set(appId, permission, enabled)\npermission.disableSuperuser()\npermission.name(permission)\npermission.list()\npermission.holder()\npermission.isSuperuser()")
  ui.text("ask requests one of the six permissions. has checks effective access, including inherited Superuser access. set requires Modify permissions and can change ordinary permissions but always refuses Superuser. disableSuperuser only works when called by the current holder itself. name returns a friendly label. list returns permission ids. holder returns the holder app id or empty text. isSuperuser tests actual ownership.", "small")

  ui.section("17 · Foreground timers")
  ui.code("timer.after(name, milliseconds, eventName)\ntimer.every(name, milliseconds, eventName)\ntimer.stop(name)\ntimer.isRunning(name)\ntimer.list()")
  ui.text("Foreground timers require no permission and exist only while the current app runtime exists. after fires once; every repeats. Their events include event.type = timer, event.name, and event.time. Use background processes instead when work must survive leaving the app.", "small")

  ui.section("18 · Background API")
  ui.code("background.start(name, milliseconds, eventName)\nbackground.stop(name)\nbackground.isRunning(name)\nbackground.list()")
  ui.text("start requires Run background processes and runs at a minimum interval enforced by the kernel. stop terminates one named process. isRunning checks one process. list returns the current app's background process names. Revoking Background stops that app's processes.", "small")

  ui.section("19 · Native dialog API")
  ui.code("dialog.alert(title, message, detail)\ndialog.confirm(title, message, detail)\ndialog.danger(title, message, detail)\ndialog.choose(title, message, yesLabel, noLabel, detail)")
  ui.text("Dialogs are drawn by MellorsOS, never browser pop-ups. alert returns true after dismissal. confirm, danger, and choose return true or false. Put the dialog call before other side effects in its event handler because MScript resumes the handler after the user answers.", "small")

  ui.section("20 · Custom events")
  ui.code("events.emit(name, value)")
  ui.text("emit queues a custom event in the same app. Handle it with on name. The event object contains type = custom, name, and value.", "small")

  ui.section("21 · System API")
  ui.code("system.toast(message)\nsystem.log(message)\nsystem.reset()\nsystem.reboot()\nsystem.setAppHidden(id, hidden)\nsystem.info(key)\nsystem.time()\nsystem.date()\nsystem.now()\nsystem.uptime()\nsystem.random(min, max)\nsystem.storageBytes()\nsystem.screenWidth()\nsystem.screenHeight()\nsystem.vibrate(milliseconds)\nsystem.clipboard(text)")
  ui.text("toast shows a temporary OS message and log writes to System Monitor. reset starts the native factory-reset flow; reboot reloads MellorsOS; both require effective Superuser authority. setAppHidden is a privileged visibility control. info keys include name, version, engine, platform, language, online, apps, systemApps, userApps, storageKeys, userAgent, and superuser. time/date return formatted local values, now returns epoch milliseconds, uptime returns emulator seconds, random returns an integer, storageBytes estimates MellorsOS storage, screenWidth/screenHeight report emulator dimensions, vibrate uses device vibration when available, and clipboard copies text when the browser permits it.", "small")

  ui.section("22 · Math API")
  ui.code("math.eval(expression)\nmath.round(value, decimals)\nmath.abs(value)\nmath.floor(value)\nmath.ceil(value)\nmath.min(a, b)\nmath.max(a, b)\nmath.clamp(value, min, max)\nmath.sqrt(value)\nmath.pow(value, power)")
  ui.text("math.eval evaluates arithmetic-only text. round supports decimal places. abs/floor/ceil perform standard numeric transforms. min/max compare values. clamp constrains a value. sqrt and pow provide square-root and exponent operations.", "small")

  ui.section("23 · Text API")
  ui.code("text.length(value)\ntext.upper(value)\ntext.lower(value)\ntext.trim(value)\ntext.contains(value, query)\ntext.startsWith(value, query)\ntext.endsWith(value, query)\ntext.replace(value, old, new)\ntext.slice(value, start, end)\ntext.indexOf(value, query)\ntext.part(value, separator, index)\ntext.count(value, separator)\ntext.repeat(value, count)")
  ui.text("All text functions convert their inputs to strings. part is useful with | separated lists returned by MScript APIs. count returns the number of separated parts. repeat is capped by the runtime to prevent extreme output.", "small")

  ui.section("24 · JSON API")
  ui.code("json.stringify(value)\njson.parse(text)\njson.get(jsonOrObject, key, fallback)\njson.set(jsonOrObject, key, value)")
  ui.text("stringify serializes a value. parse creates a JavaScript-compatible MScript value. get safely reads one object key. set updates one key and returns JSON text, making it convenient to persist structured data without object-literal syntax.", "small")

  ui.section("25 · Value conversion API")
  ui.code("value.number(value)\nvalue.string(value)\nvalue.bool(value)\nvalue.type(value)")
  ui.text("number converts to a number, string converts to text, bool applies truthiness, and type returns number, string, boolean, object, array, null, undefined, or function as appropriate.", "small")

  ui.section("26 · Toast shorthand")
  ui.code("toast(\"Saved\")")
  ui.text("toast is a top-level shorthand for system.toast(message). It is retained for simple apps.", "small")

  ui.section("27 · Complete API parameter reference")
  ui.text("The reference below is generated from the actual running MScript API, so every exposed function is listed. Each parameter shows its purpose, expected kind of value, and default when one exists. UI control IDs may be quoted strings such as \"save\" or bare identifiers such as save; both match event handlers like on click save.", "small")
  ui.apiReference()

  ui.section("28 · Full secure example")
  ui.code("app \"Reminder\"\nmeta id \"example.reminder\"\nmeta icon \"✓\"\nmeta color \"#21b8a6\"\n\non start\n  ui.header(\"Reminder\", \"Permission-aware example\")\n  ui.input(\"message\", \"Message\", data.get(\"message\", \"Hello\"))\n  ui.button(\"save\", \"Save and notify\")\nend\n\non click save\n  let message = ui.value(\"message\")\n  data.set(\"message\", message)\n  if permission.has(\"notifications\") || permission.ask(\"notifications\")\n    notify.send(\"Reminder\", message)\n  else\n    dialog.alert(\"Saved locally\", \"Notification permission was declined.\")\n  end\nend")
  ui.button("studio", "Open App Studio", "primary")
end

on click studio
  app.open("studio")
end`;

