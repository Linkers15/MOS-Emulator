<body>
<div id="device">
  <div id="wallpaper"></div>
  <div id="statusbar"><span id="clockMini">9:41</span><span id="statusIcons"><span id="devDot" class="hidden">● DEV</span><span>◉</span><span>⌁</span><span id="battery">100%</span></span></div>
  <main id="appRoot"></main>
  <nav id="nav"><button class="navbtn" id="navBack" aria-label="Back">‹</button><button class="navbtn" id="navHome" aria-label="Home">●</button><button class="navbtn" id="navRecents" aria-label="Recent apps">▢</button></nav>
  <div id="toast"></div>
  <section id="notificationShade"><div class="shade-handle"></div><div class="row"><div><div class="big-number" id="shadeTime">9:41</div><div class="small" id="shadeDate"></div></div><button class="secondary" id="clearNotifications">Clear</button></div><div id="shadeNotifications"></div></section>
  <div id="osModalHost" role="dialog" aria-modal="true" aria-live="assertive"></div>
</div>
<script>
(() => {
"use strict";

/* ================================================================
   MellorsOS Kernel
   UI shell + MScript runtime. Every built-in app below is MScript.
   ================================================================ */
const $ = s => document.querySelector(s);
const root = $('#appRoot');
const device = $('#device');
const STORAGE_PREFIX = 'mellorsos.';
const state = {
  current:null, history:[], recents:[], notifications:[], appInstances:new Map(),
  background:new Map(), eventBus:new Map(), logs:[], developer:false
};
const defaults = {
  accent:'#6d7cff', accent2:'#a96cff', wallpaper:'aurora', gridCols:4, iconSize:58, iconShape:'squircle',
  showAppLabels:true, homeTitle:'MellorsOS', homeSubtitle:'Programmable by design', username:'Owner',
  fontScale:1, compact:false, highContrast:false, reduceMotion:false, reduceTransparency:false, largeTargets:false, boldText:false,
  haptics:true, showSeconds:false, clock24h:false, showBattery:true, showStatusIcons:true, navCompact:false,
  notificationToasts:true, notificationPreview:true, notificationLimit:50, developerMode:false, showFPS:false
};
const memoryStorage = new Map();
function storageKeys(){ try{return Object.keys(localStorage);}catch{return [...memoryStorage.keys()];} }
const store = {
  rawGet(k, fallback=null){
    const key=STORAGE_PREFIX+k;
    try{const v=localStorage.getItem(key);if(v!==null)return JSON.parse(v);}catch{}
    try{return memoryStorage.has(key)?JSON.parse(memoryStorage.get(key)):fallback;}catch{return fallback;}
  },
  rawSet(k,v){const key=STORAGE_PREFIX+k, encoded=JSON.stringify(v);try{localStorage.setItem(key,encoded);}catch{memoryStorage.set(key,encoded);}return v;},
  rawDelete(k){const key=STORAGE_PREFIX+k;try{localStorage.removeItem(key);}catch{}memoryStorage.delete(key);},
  keys(prefix=''){return storageKeys().filter(k=>k.startsWith(STORAGE_PREFIX+prefix)).map(k=>k.slice(STORAGE_PREFIX.length));},
  clearAll(){storageKeys().filter(k=>k.startsWith(STORAGE_PREFIX)).forEach(k=>{try{localStorage.removeItem(k);}catch{}memoryStorage.delete(k);});}
};
const PERMISSIONS = Object.freeze({
  settings:'Modify system settings',
  notifications:'Notifications',
  installApps:'Install apps',
  modifyPermissions:'Modify permissions',
  superuser:'Superuser',
  background:'Run background processes'
});
function permissionRecords(){return store.rawGet('permissions',{})||{};}
function permissionRecord(appId){return permissionRecords()[appId]||{};}
function savePermissionRecord(appId,record){const all=permissionRecords();all[appId]=record;store.rawSet('permissions',all);return record;}
function migrateLegacyPermissions(){
  const all=permissionRecords();let changed=false;let holder=null;
  for(const id of Object.keys(all).sort()){
    const rec=all[id]||{};
    if(rec.mdm===true||rec.superuser===true){
      if(holder===null){rec.superuser=true;holder=id;}else if(rec.superuser===true){delete rec.superuser;}
      changed=true;
    }
    if(Object.prototype.hasOwnProperty.call(rec,'mdm')){delete rec.mdm;changed=true;}
    all[id]=rec;
  }
  if(changed)store.rawSet('permissions',all);
}

migrateLegacyPermissions();
function validPermission(permission){return Object.prototype.hasOwnProperty.call(PERMISSIONS,String(permission));}
function superuserHolder(){const all=permissionRecords();for(const [id,rec] of Object.entries(all))if(rec?.superuser===true)return id;return null;}
function hasPermission(app,permission){
  if(!app)return false;
  if(app.system)return true;
  permission=String(permission);
  if(!validPermission(permission))return false;
  const rec=permissionRecord(app.meta.id);
  return rec.superuser===true || rec[permission]===true;
}
function stopAppBackground(appId){for(const key of [...state.background.keys()])if(key.startsWith(appId+':')){const id=state.background.get(key);clearInterval(id);state.background.delete(key);}}
function setAppPermission(appId,permission,value){
  permission=String(permission);if(!validPermission(permission)||permission==='superuser')return false;
  const target=getApp(appId);if(target?.system)return false;
  const rec=permissionRecord(appId);rec[permission]=!!value;savePermissionRecord(appId,rec);
  if(permission==='background'&&!value)stopAppBackground(appId);
  return true;
}
function grantSuperuserFromRequest(appId){
  const app=getApp(appId);if(!app||app.system)return false;
  const holder=superuserHolder();if(holder&&holder!==appId)return false;
  const rec=permissionRecord(appId);rec.superuser=true;savePermissionRecord(appId,rec);return true;
}
function disableOwnSuperuser(appId){
  if(superuserHolder()!==appId)return false;
  const rec=permissionRecord(appId);delete rec.superuser;savePermissionRecord(appId,rec);return true;
}
function permissionLabel(permission){return PERMISSIONS[String(permission)]||String(permission);}
class PermissionDeniedError extends Error{constructor(permission,line=0){super(`Ungranted permission: ${permissionLabel(permission)}`);this.line=line;this.permission=String(permission);this.isPermissionDenied=true;}}
class PermissionPromptRequest extends Error{constructor(permission){super(`Permission prompt: ${permission}`);this.permission=String(permission);this.isPermissionPrompt=true;}}
class DialogPromptRequest extends Error{constructor(key,options){super(`Dialog prompt: ${key}`);this.key=String(key);this.options=options;this.isDialogPrompt=true;}}
function requirePermission(rt,permission){if(!hasPermission(rt.app,permission))throw new PermissionDeniedError(permission);return true;}
function requestPermission(rt,permission){
  permission=String(permission);
  if(!validPermission(permission))throw new MScriptError(`Unknown permission ${permission}`);
  if(rt.permissionResume.has(permission)){const answer=rt.permissionResume.get(permission);rt.permissionResume.delete(permission);return !!answer;}
  if(hasPermission(rt.app,permission))return true;
  throw new PermissionPromptRequest(permission);
}
function requestDialog(rt,kind,title,message,detail='',yesLabel='OK',noLabel='Cancel'){
  const key=[kind,title,message,detail,yesLabel,noLabel].join('\u241f');
  if(rt.dialogResume.has(key)){const answer=rt.dialogResume.get(key);rt.dialogResume.delete(key);return answer;}
  throw new DialogPromptRequest(key,{kind:String(kind),title:String(title),message:String(message),detail:String(detail),yesLabel:String(yesLabel),noLabel:String(noLabel)});
}
async function handleDialogPrompt(req){
  const o=req.options||{};
  if(o.kind==='alert'){await showOSDialog({icon:'ℹ️',title:o.title,message:o.message,detail:o.detail,buttons:[{label:o.yesLabel||'OK',value:true,kind:'primary'}]});return true;}
  return await showOSDialog({icon:o.kind==='danger'?'⚠️':'◆',title:o.title,message:o.message,detail:o.detail,buttons:[{label:o.noLabel||'Cancel',value:false,kind:'secondary'},{label:o.yesLabel||'OK',value:true,kind:o.kind==='danger'?'danger':'primary'}]});
}
let settings = {...defaults, ...(store.rawGet('settings',{})||{})};
