function backgroundStart(rt,name,ms,eventName){const key=`${rt.app.meta.id}:${name}`;backgroundStop(rt.app.meta.id,name);const id=setInterval(()=>{if(!hasPermission(rt.app,'background')){crashForPermission(rt,new PermissionDeniedError('background'));return;}rt.trigger(eventName,{type:'background',name,time:Date.now()});},Math.max(250,ms));state.background.set(key,id);rt.timerNames.add(name);log(`Background process started: ${key} every ${ms}ms`);}
