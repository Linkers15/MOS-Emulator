.compact .card{padding:10px;margin:6px 0}.compact .row+.row{margin-top:8px;padding-top:8px}
.large-targets button,.large-targets .toggle{min-height:48px}.bold-text{font-weight:600}.bold-text .row-title,.bold-text .app-header-title,.bold-text .home-title{font-weight:950}.reduce-transparency #nav,.reduce-transparency .app-page,.reduce-transparency .card,.reduce-transparency #notificationShade{backdrop-filter:none!important;background-color:#11162a!important}.nav-compact #nav{height:56px}.nav-compact #appRoot{bottom:56px}.nav-compact #notificationShade{bottom:56px}.nav-compact .navbtn{height:40px}
#osModalHost{position:absolute;inset:0;z-index:140;display:none;align-items:flex-end;justify-content:center;background:rgba(2,4,10,.66);backdrop-filter:blur(10px);padding:14px}#osModalHost.open{display:flex}.os-modal{width:100%;max-height:86%;overflow:auto;background:linear-gradient(180deg,#171c31,#0d1121);border:1px solid rgba(255,255,255,.14);border-radius:26px;padding:18px;box-shadow:0 24px 70px rgba(0,0,0,.55);animation:modalIn .18s ease}.os-modal-icon{width:52px;height:52px;border-radius:17px;display:grid;place-items:center;background:rgba(109,124,255,.18);font-size:1.65rem;margin-bottom:12px}.os-modal-title{font-size:1.28rem;font-weight:900;letter-spacing:-.02em}.os-modal-body{color:#e2e6f7;line-height:1.5;margin-top:8px}.os-modal-detail{color:var(--muted);font-size:.78rem;line-height:1.5;margin-top:10px}.os-modal-actions{display:grid;gap:8px;margin-top:16px}.os-modal-actions button{width:100%;margin:0;min-height:46px}.disabled-control{opacity:.42;pointer-events:none}.permission-inherited{opacity:.48;pointer-events:none}.app-manager-card .manager-actions{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px}.status-pill{display:inline-flex;align-items:center;padding:4px 8px;border-radius:999px;background:rgba(255,255,255,.08);font-size:.7rem;color:var(--muted);font-weight:800}.status-pill.superuser{background:rgba(255,93,120,.16);color:#ffabb9}.status-pill.system{background:rgba(70,215,163,.13);color:#8eecc8}@keyframes modalIn{from{opacity:0;transform:translateY(18px) scale(.98)}to{opacity:1;transform:none}}

.menu-entry{width:100%;border:0;background:var(--panel);color:var(--text);border:1px solid rgba(255,255,255,.09);border-radius:20px;padding:14px;margin:8px 0;display:flex;align-items:center;gap:12px;text-align:left;cursor:pointer}.menu-entry:active{transform:scale(.985)}.menu-icon{width:42px;height:42px;border-radius:14px;background:rgba(255,255,255,.09);display:grid;place-items:center;font-size:1.3rem;flex:0 0 auto}.menu-copy{min-width:0;flex:1}.menu-value{color:var(--muted);font-size:.78rem;max-width:34%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.menu-chevron{color:var(--muted);font-size:1.35rem}.alert{border-left:4px solid var(--accent)}.alert.warning{border-left-color:#f0a33b}.alert.danger{border-left-color:var(--danger)}.alert.success{border-left-color:var(--ok)}.ui-divider{height:1px;background:rgba(255,255,255,.09);margin:12px 2px}.segmented{display:flex;gap:5px;padding:4px;background:rgba(255,255,255,.06);border-radius:14px}.segment{flex:1;border:0;background:transparent;color:var(--muted);padding:9px 7px;border-radius:11px;font-size:.76rem;font-weight:800}.segment.selected{background:var(--accent);color:white}.chip-wrap{display:flex;gap:7px;flex-wrap:wrap}.chip{border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.07);color:var(--text);border-radius:999px;padding:7px 11px;font-size:.76rem}.chip.selected{background:var(--accent);border-color:var(--accent)}.ui-stat{display:inline-flex;flex-direction:column;min-width:92px;padding:12px;border-radius:16px;background:rgba(255,255,255,.06);margin:4px}.ui-stat strong{font-size:1.2rem}.ui-hidden{display:none!important}.ui-disabled{opacity:.42!important;pointer-events:none!important}
